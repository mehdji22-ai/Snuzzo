{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Anton'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'anton-latin.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 200 1000; font-display: swap; src: url({{ 'nunito-sans-latin.woff2' | asset_url }}) format('woff2'); }
    </style>
    {{ 'snuzzo.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section page-width" style="text-align:center">
      <h1 class="h2">{{ 'gift_card.title' | t }}</h1>
      <p class="h1" style="margin:24px 0">{{ gift_card.balance | money }}</p>
      <p class="label">{{ 'gift_card.code' | t }}</p>
      <p style="font-size:28px;font-weight:900;letter-spacing:.1em">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}">Apple Wallet</a></p>{%- endif -%}
      <p style="margin-top:24px"><a class="btn btn--ink" href="{{ shop.url }}">{{ 'general.continue' | t }}</a> <button class="btn btn--white btn--no-arrow" style="border:1px solid var(--ink)" onclick="window.print()">{{ 'gift_card.print' | t }}</button></p>
    </main>
  </body>
</html>
