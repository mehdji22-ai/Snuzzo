    "faq": {
      "type": "faq",
      "blocks": {
        "q0": {
          "type": "question",
          "settings": {
            "question": "Are they really certified organic cotton?",
            "answer": "<p>Yes. Every onesie is made from certified organic cotton, so you know exactly what your baby is wearing.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "Are they safe for my baby’s skin?",
            "answer": "<p>Yes. Organic cotton is soft and gentle, which makes it a lovely choice for delicate newborn skin.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What size should I order?",
            "answer": "<p>Our onesies have a roomy, comfortable fit. If your baby is between sizes, we suggest the larger one, so there’s space to wiggle and grow.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Are diaper changes really easy?",
            "answer": "<p>Yes. We designed them for quick, simple changes, even in the middle of the night.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will they stay soft after washing?",
            "answer": "<p>Yes. They’re made to stay soft wash after wash. Follow the care label and they’ll keep feeling like new.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Is it a good gift?",
            "answer": "<p>Yes. Every order arrives in gift-ready packaging, so it’s ready to give the moment it lands.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Can I return an order?",
            "answer": "<p>Yes. Every order is covered by our 30-day money-back guarantee. If it isn’t right for your little one, we’ll refund you.</p>"
          }
        }
