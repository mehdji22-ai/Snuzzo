<section class="section bg-{{ section.settings.bg }}"><div class="page-width">
  {%- if section.settings.heading != blank -%}
    <div class="sec-head sec-head--center"><h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="mute">{{ section.settings.text }}</p>{%- endif -%}</div>
  {%- endif -%}
  <div class="vids">
    {%- for block in section.blocks -%}
      <div class="vids__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '600x' }}
        {%- elsif block.settings.video_url != blank -%}
          <video data-lazy-video="{{ block.settings.video_url }}" loop muted playsinline preload="none"{% if block.settings.caption != blank %} aria-label="{{ block.settings.caption | escape }}"{% endif %}></video>
        {%- elsif block.settings.image != blank -%}
          {% render 'media', image: block.settings.image, alt: block.settings.caption, sizes: '(min-width: 750px) 25vw, 60vw' %}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Family videos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your little ones in Snuzzo" },
    { "type": "text", "id": "text", "label": "Text", "default": "So happy to have you here. Tag us @littlesnuzzo" },
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ] }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video or photo",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (from your Shopify Files)" },
        { "type": "text", "id": "video_url", "label": "Or a video link (.mp4)" },
        { "type": "image_picker", "id": "image", "label": "Or a photo" },
        { "type": "text", "id": "caption", "label": "Description (for screen readers)" }
      ]
    }
  ],
  "presets": [{ "name": "Family videos" }]
}
{% endschema %}
