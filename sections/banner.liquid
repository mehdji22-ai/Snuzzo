<section class="banner" style="min-height: {{ section.settings.height }}px">
  {% render 'media', image: section.settings.image, demo: section.settings.demo, alt: section.settings.alt, sizes: '100vw' %}
  <div class="banner__text">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:#fff">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h1">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button != blank -%}<a class="btn btn--white" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "alt", "label": "Image description" },
    { "type": "text", "id": "demo", "label": "Demo image (advanced)" },
    { "type": "text", "id": "eyebrow", "label": "Small line above" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Next up: first snow" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "range", "id": "height", "label": "Height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 600 }
  ],
  "presets": [{ "name": "Banner" }]
}
{% endschema %}
