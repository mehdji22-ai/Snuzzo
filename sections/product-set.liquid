{%- assign items = section.settings.products -%}
{%- if items.size > 0 -%}
<section class="section page-width">
  <div class="set">
    <div class="set__intro">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button != blank -%}<a class="btn btn--ink" href="{{ section.settings.link | default: items.first.url }}">{{ section.settings.button }}</a>{%- endif -%}
    </div>
    <div class="set__items">
      {%- for p in items limit: 3 -%}
        {%- assign step_label = 'products.step' | t: n: forloop.index -%}
        {% render 'product-card', product: p, step: step_label, sizes: '(min-width: 990px) 20vw, 50vw' %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product set",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Bedtime Set" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Bath, onesie, lights low. Three little helpers for an easier wind-down." },
    { "type": "product_list", "id": "products", "label": "Products (up to 3)", "limit": 3 },
    { "type": "text", "id": "button", "label": "Button (optional)" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Product set" }]
}
{% endschema %}
