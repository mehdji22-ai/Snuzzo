<section class="social section">
  <div class="page-width social__grid">
    <div>
      <div class="social__num">{{ section.settings.number }}</div>
      <p class="social__text">{{ section.settings.text }}</p>
      {%- assign link = section.settings.link | default: settings.social_facebook -%}
      {%- if link != blank -%}
        <a class="btn btn--ink" href="{{ link }}" target="_blank" rel="noopener">{{ section.settings.button }}</a>
      {%- endif -%}
    </div>
    <div class="social__photos">
      {%- assign demos = 'demo-mom-pig.webp,demo-lion.webp,demo-hoodie-pink.webp,demo-bath.webp,demo-tiger.webp,demo-snow-navy.webp' | split: ',' -%}
      {%- assign alts = 'Parent cuddling a baby in a pig onesie|Baby in a lion onesie|Parent and baby in a pink carrier hoodie|Baby in the bath wearing a bath visor|Toddler in a tiger onesie|Toddler in a navy snowsuit' | split: '|' -%}
      {%- for i in (1..6) -%}
        {%- assign key = 'photo_' | append: i -%}
        {%- assign idx = i | minus: 1 -%}
        {% render 'media', image: section.settings[key], demo: demos[idx], alt: alts[idx], sizes: '(min-width: 750px) 18vw, 33vw' %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "number", "label": "Big number", "default": "450K", "info": "Use only your real number." },
    { "type": "text", "id": "text", "label": "Text", "default": "Parents following along on Facebook. Your photos could be next." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Follow Snuzzo" },
    { "type": "url", "id": "link", "label": "Button link", "info": "Defaults to the Facebook link in Theme settings." },
    { "type": "image_picker", "id": "photo_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "photo_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "photo_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "photo_4", "label": "Photo 4" },
    { "type": "image_picker", "id": "photo_5", "label": "Photo 5" },
    { "type": "image_picker", "id": "photo_6", "label": "Photo 6" }
  ],
  "presets": [{ "name": "Social band" }]
}
{% endschema %}
