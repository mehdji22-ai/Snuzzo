{%- assign pairs = section.blocks | where: 'type', 'animal' -%}
<section class="ba section" id="before-after">
  <div class="page-width ba__grid">
    <div>
      <h2 class="h2 ba__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ba__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if pairs.size > 1 -%}
        <div class="ba__chips" role="group" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in pairs -%}
            <button type="button" class="ba__chip" data-ba-chip="{{ block.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.link != blank -%}
        <p style="margin-top:24px"><a class="btn btn--ghost" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>
      {%- endif -%}
    </div>

    <div>
      {%- if pairs.size > 0 -%}
        {%- for block in pairs -%}
          {%- liquid
            assign before_alt = block.settings.label | append: ': ' | append: section.settings.before_label
            assign after_alt = block.settings.label | append: ': ' | append: section.settings.after_label
          -%}
          <div class="ba__stage" data-ba data-ba-pair="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
            {% render 'media', image: block.settings.before, demo: 'demo-panda-before.webp', alt: before_alt, sizes: '(min-width: 750px) 58vw, 100vw' %}
            <div class="ba__after" style="position:absolute;inset:0">
              {% render 'media', image: block.settings.after, demo: 'demo-panda.webp', alt: after_alt, sizes: '(min-width: 750px) 58vw, 100vw' %}
            </div>
            <div class="ba__line"></div>
            <span class="ba__tag ba__tag--l">{{ block.settings.label }}</span>
            <span class="ba__tag ba__tag--r">{{ section.settings.before_label }}</span>
            <label class="visually-hidden" for="BA-{{ block.id }}">{{ block.settings.label }}: {{ section.settings.heading }}</label>
            <input class="ba__range" id="BA-{{ block.id }}" type="range" min="0" max="100" value="55">
            <span class="ba__knob" aria-hidden="true">← Drag →</span>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="ba__stage" data-ba>
          {% render 'media', demo: 'demo-panda-before.webp', alt: 'Toddler in plain pyjamas' %}
          <div class="ba__after" style="position:absolute;inset:0">{% render 'media', demo: 'demo-panda.webp', alt: 'The same toddler in a panda onesie' %}</div>
          <div class="ba__line"></div>
          <span class="ba__tag ba__tag--l">{{ section.settings.after_label }}</span>
          <span class="ba__tag ba__tag--r">{{ section.settings.before_label }}</span>
          <label class="visually-hidden" for="BA-{{ section.id }}">{{ section.settings.heading }}</label>
          <input class="ba__range" id="BA-{{ section.id }}" type="range" min="0" max="100" value="55">
          <span class="ba__knob" aria-hidden="true">← Drag →</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / after",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The half hour before bed." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Bath, then panda, then lights low. Same toddler, same sofa. Drag across the photo to watch the wind-down start." },
    { "type": "text", "id": "after_label", "label": "Label on the 'after' side (when no animals are added)", "default": "Panda" },
    { "type": "text", "id": "before_label", "label": "Label on the 'before' side", "default": "Pyjamas" },
    { "type": "url", "id": "link", "label": "Button link (optional)" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Pick your animal" }
  ],
  "blocks": [
    {
      "type": "animal",
      "name": "Animal pair",
      "settings": [
        { "type": "text", "id": "label", "label": "Animal name", "default": "Panda" },
        { "type": "image_picker", "id": "after", "label": "After photo (in the onesie)" },
        { "type": "image_picker", "id": "before", "label": "Before photo (pyjamas)", "info": "Use photos of the same shape, ideally portrait." }
      ]
    }
  ],
  "presets": [{ "name": "Before / after", "blocks": [{ "type": "animal" }] }]
}
{% endschema %}
