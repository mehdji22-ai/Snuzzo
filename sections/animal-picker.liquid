{%- liquid
  assign coll = section.settings.collection
  assign default_bullets = section.settings.bullet_1 | append: '||' | append: section.settings.bullet_2 | append: '||' | append: section.settings.bullet_3 | split: '||'
  assign add_tpl = 'products.add_the' | t
  assign count_tpl = 'products.animal_count' | t
  assign demo_names = 'Panda,Bunny,Duck,Lion,Penguin,Tiger,Monkey,Pig,Reindeer' | split: ','
  assign demo_files = 'demo-panda.webp,demo-bunny.webp,demo-duck.webp,demo-lion.webp,demo-penguin.webp,demo-tiger.webp,demo-monkey.webp,demo-mom-pig.webp,demo-reindeer.webp' | split: ','
-%}

<section class="section page-width" data-picker>
  <div class="picker__head">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.show_rating and settings.rating_text != blank -%}
      <span class="picker__rating">{{ settings.rating_text }}</span>
    {%- endif -%}
  </div>

  {%- if coll != blank and coll.products_count > 0 -%}
    {%- capture json -%}
      [
      {%- for product in coll.products limit: section.settings.limit -%}
        {%- liquid
          assign short = product.metafields.custom.animal_name.value | default: product.title
          assign short = short | remove: 'The Little ' | remove: 'The '
          assign v = product.selected_or_first_available_variant
          assign bl = product.metafields.custom.benefits.value | default: default_bullets
          assign img = product.featured_image
        -%}
        {
          "title": {{ product.title | json }},
          "short": {{ short | json }},
          "url": {{ product.url | json }},
          "image": {% if img %}{{ img | image_url: width: 1100 | json }}{% else %}""{% endif %},
          "srcset": {% if img %}{{ img | image_url: width: 600 | append: ' 600w, ' | append: img | image_url: width: 1100 | append: ' 1100w' | json }}{% else %}""{% endif %},
          "alt": {{ img.alt | default: product.title | json }},
          "price": {{ v.price | money | json }},
          "available": {{ product.available | json }},
          "variant": {{ v.id | json }},
          "variants": [{% for vv in product.variants %}{"id": {{ vv.id }}, "title": {{ vv.title | json }}, "available": {{ vv.available | json }}, "price": {{ vv.price | money | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
          "bullets": [{% for b in bl %}{% if b != blank %}{{ b | json }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
      ]
    {%- endcapture -%}
    <script type="application/json" data-picker-json>{{ json }}</script>

    <div class="picker__chips" role="group" aria-label="{{ section.settings.heading | escape }}">
      {%- for product in coll.products limit: section.settings.limit -%}
        {%- assign short = product.metafields.custom.animal_name.value | default: product.title | remove: 'The Little ' | remove: 'The ' -%}
        {%- assign chip_img = product.metafields.custom.swatch.value | default: product.featured_image -%}
        <button type="button" class="chip" data-chip data-index="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
          {%- if chip_img -%}
            {{ chip_img | image_url: width: 240, height: 240, crop: 'center' | image_tag: class: 'chip__img', alt: '', loading: 'lazy', width: 118, height: 118 }}
          {%- else -%}
            <span class="chip__img"></span>
          {%- endif -%}
          <span class="chip__label">{{ short }}</span>
        </button>
      {%- endfor -%}
    </div>

    {%- assign first = coll.products.first -%}
    {%- assign v = first.selected_or_first_available_variant -%}
    {%- assign short = first.metafields.custom.animal_name.value | default: first.title | remove: 'The Little ' | remove: 'The ' -%}
    {%- assign bl = first.metafields.custom.benefits.value | default: default_bullets -%}
    <div class="feature">
      <a href="{{ first.url }}" data-f-link tabindex="-1" aria-hidden="true">
        {%- if first.featured_image -%}
          {{ first.featured_image | image_url: width: 1100 | image_tag: class: 'feature__img', data-f-img: '', widths: '600, 1100', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'feature__img placeholder-svg' }}
        {%- endif -%}
      </a>
      {%- form 'product', first, class: 'feature__body', data-ajax-add: '' -%}
        <div class="eyebrow" data-f-count data-template="{{ count_tpl | escape }}">{{ count_tpl | replace: '[n]', '1' | replace: '[total]', coll.products.size }}</div>
        <h3 class="feature__name" data-f-name>{{ first.title }}</h3>
        <ul class="bullets" data-f-bullets>
          {%- for b in bl -%}{%- if b != blank -%}<li>{{ b }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        <div class="feature__price" data-f-price>{{ v.price | money }}</div>
        <label class="visually-hidden" for="PickerVariant-{{ section.id }}">{{ 'products.choose' | t: option: first.options.first }}</label>
        <select id="PickerVariant-{{ section.id }}" name="id" data-f-id class="picker__variant" {% if first.has_only_default_variant %}hidden{% endif %}>
          {%- for vv in first.variants -%}
            <option value="{{ vv.id }}"{% if vv.id == v.id %} selected{% endif %}{% unless vv.available %} disabled{% endunless %}>{{ vv.title }}</option>
          {%- endfor -%}
        </select>
        <button type="submit" class="btn btn--ink" data-f-btn data-template="{{ add_tpl | escape }}"{% unless first.available %} disabled{% endunless %}>
          {%- if first.available -%}{{ add_tpl | replace: '[animal]', short }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
        <p class="buy-msg" data-buy-msg role="status" aria-live="polite"></p>
        {%- if settings.shipping_note != blank -%}<div class="feature__note">{{ settings.shipping_note }}</div>{%- endif -%}
      {%- endform -%}
    </div>

  {%- else -%}
    {%- comment -%} Demo mode: shown until a collection is picked in the theme editor {%- endcomment -%}
    {%- capture json -%}
      [{%- for n in demo_names -%}{"title": {{ 'The ' | append: n | json }}, "short": {{ n | json }}, "url": {{ routes.all_products_collection_url | json }}, "image": {{ demo_files[forloop.index0] | asset_url | json }}, "alt": {{ 'Toddler in a ' | append: n | downcase | append: ' onesie' | json }}, "price": "", "available": true, "variant": "", "variants": [], "bullets": []}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
    {%- endcapture -%}
    <script type="application/json" data-picker-json>{{ json }}</script>
    <div class="picker__chips" role="group" aria-label="{{ section.settings.heading | escape }}">
      {%- for n in demo_names -%}
        <button type="button" class="chip" data-chip data-index="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
          <img class="chip__img" src="{{ demo_files[forloop.index0] | asset_url }}" alt="" loading="lazy" width="118" height="118">
          <span class="chip__label">{{ n }}</span>
        </button>
      {%- endfor -%}
    </div>
    <div class="feature">
      <a href="{{ routes.all_products_collection_url }}" data-f-link tabindex="-1" aria-hidden="true"><img class="feature__img" data-f-img src="{{ 'demo-panda.webp' | asset_url }}" width="820" height="820" alt="Toddler in a panda onesie" loading="lazy"></a>
      <div class="feature__body">
        <div class="eyebrow" data-f-count data-template="{{ count_tpl | escape }}">{{ count_tpl | replace: '[n]', '1' | replace: '[total]', demo_names.size }}</div>
        <h3 class="feature__name" data-f-name>The Panda</h3>
        <ul class="bullets">{%- for b in default_bullets -%}<li>{{ b }}</li>{%- endfor -%}</ul>
        <a class="btn btn--ink" href="{{ routes.all_products_collection_url }}">Shop the animals</a>
        <div class="feature__note">Demo mode: pick your animal collection in the theme editor to show real products and prices.</div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Animal picker",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who are they tonight?" },
    { "type": "checkbox", "id": "show_rating", "label": "Show store rating (from Theme settings)", "default": true },
    { "type": "collection", "id": "collection", "label": "Animal collection", "info": "Put every animal onesie in one collection, e.g. 'animal-onesies'." },
    { "type": "range", "id": "limit", "label": "Max animals", "min": 3, "max": 16, "step": 1, "default": 12 },
    { "type": "header", "content": "Default benefits" },
    { "type": "paragraph", "content": "Used when a product has no 'custom.benefits' metafield." },
    { "type": "text", "id": "bullet_1", "label": "Benefit 1", "default": "Padded 3D hood that's soft when they roll back" },
    { "type": "text", "id": "bullet_2", "label": "Benefit 2", "default": "Chin-guard zip for quick 3 a.m. changes" },
    { "type": "text", "id": "bullet_3", "label": "Benefit 3", "default": "Cloud-soft plush with a smooth fleece lining" }
  ],
  "presets": [{ "name": "Animal picker" }]
}
{% endschema %}
