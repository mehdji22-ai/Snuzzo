{%- assign hero_img = section.settings.image | default: collection.image -%}
<section class="coll-hero{% if hero_img == blank %} coll-hero--plain{% endif %}" style="min-height: {% if hero_img == blank %}0{% else %}{{ section.settings.height }}px{% endif %}">
  {%- if hero_img != blank -%}{{ hero_img | image_url: width: 2400 | image_tag: widths: '750, 1100, 1600, 2400', sizes: '100vw', loading: 'eager', alt: '' }}{%- endif -%}
  <div class="coll-hero__text page-width" style="width:100%">
    <h1 class="h1">{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}<div class="rte" style="margin-top:12px;max-width:56ch;font-size:17px">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (defaults to the collection image)" },
    { "type": "range", "id": "height", "label": "Height", "min": 280, "max": 720, "step": 20, "unit": "px", "default": 460 },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true }
  ]
}
{% endschema %}
