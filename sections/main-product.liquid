{%- liquid
  assign v = product.selected_or_first_available_variant
  assign tagline = product.metafields.custom.tagline.value | default: section.settings.tagline
  assign promise = product.metafields.custom.one_liner.value | default: section.settings.promise
  assign questions = section.blocks | where: 'type', 'question'
  assign icons = section.blocks | where: 'type', 'icon'
-%}

<section class="pdp page-width" data-product data-update-url>
  <script type="application/json" data-variants-json>
    [{%- for vv in product.variants -%}{"id": {{ vv.id }}, "options": {{ vv.options | json }}, "price": {{ vv.price }}, "compare_at_price": {{ vv.compare_at_price | default: 0 }}, "available": {{ vv.available | json }}, "media": {{ vv.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>

  <div class="pdp__gallery">
    {%- if product.media.size > 1 -%}
      <div class="pdp__thumbs">
        {%- for media in product.media limit: section.settings.max_images -%}
          <button type="button" class="pdp__thumb" data-thumb="{{ media.id }}" aria-label="{{ 'products.show_image' | t: n: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
            {{ media.preview_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="pdp__track" data-track>
      {%- for media in product.media limit: section.settings.max_images -%}
        <div class="pdp__img" data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            {%- liquid
              assign m_loading = 'lazy'
              if forloop.first
                assign m_loading = 'eager'
              endif
              assign m_alt = media.alt | default: product.title | escape
            -%}
            {{ media | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: m_loading, alt: m_alt }}
          {%- else -%}
            {{ media | media_tag: image_size: '1400x' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="pdp__img">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endfor -%}
    </div>
  </div>

  <div class="pdp__info">
    <div class="pdp__top">
      <h1 class="pdp__title">{{ product.title }}</h1>
      {%- if tagline != blank -%}<p class="pdp__tagline">{{ tagline }}</p>{%- endif -%}
      {%- if section.settings.show_rating -%}
        {%- capture product_stars -%}{% render 'stars', product: product, size: 'lg', link: '#reviews' %}{%- endcapture -%}
        {%- if product_stars != blank -%}{{ product_stars }}{%- elsif settings.rating_text != blank -%}<a href="#reviews" class="stars" style="color:var(--mute)">{{ settings.rating_text }}</a>{%- endif -%}
      {%- endif -%}
      {%- if questions.size > 0 -%}
        <div class="qchips">
          {%- for block in questions -%}
            <button type="button" class="qchip" data-faq-jump="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>{{ block.settings.question }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if promise != blank -%}<p class="pdp__promise">{{ promise }}</p>{%- endif -%}
      <div class="pdp__price" data-price>
        {{ v.price | money }}{%- if v.compare_at_price > v.price -%} <s>{{ v.compare_at_price | money }}</s>
          {%- assign saved = v.compare_at_price | minus: v.price | money -%}
          <span class="save">{{ 'products.save' | t | replace: '[amount]', saved }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- form 'product', product, data-ajax-add: '', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ v.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign opt_key = 'option' | append: forloop.index
            assign with_images = 0
            for value in option.values
              assign vmatch = product.variants | where: opt_key, value | first
              if vmatch.featured_media
                assign with_images = with_images | plus: 1
              endif
            endfor
            assign use_swatches = false
            if with_images == option.values.size and option.values.size > 1
              assign img_ids = ''
              for value in option.values
                assign vmatch = product.variants | where: opt_key, value | first
                assign img_ids = img_ids | append: vmatch.featured_media.id | append: ','
              endfor
              assign uniq_ids = img_ids | split: ',' | uniq
              if uniq_ids.size > 1
                assign use_swatches = true
              endif
            endif
          -%}
          <fieldset class="sizes{% if use_swatches %} sizes--swatch{% endif %}" data-option-index="{{ forloop.index0 }}">
            <legend class="pdp__group-head">
              <span>{{ 'products.pick_your' | t: option: option.name }}</span>
              {%- if forloop.last -%}
                {%- if section.settings.size_chart != blank -%}
                  <button type="button" class="link-btn" data-dialog-open="SizeChart-{{ section.id }}" aria-haspopup="dialog">{{ 'products.size_guide' | t }}</button>
                {%- elsif section.settings.size_guide != blank -%}
                  <a class="link-btn" href="{{ section.settings.size_guide.url }}">{{ 'products.size_guide' | t }}</a>
                {%- endif -%}
              {%- endif -%}
            </legend>
            <span class="pdp__selected">{{ option.name }}: <b data-selected-value>{{ option.selected_value }}</b></span>
            {%- for value in option.values -%}
              {%- assign vmatch = product.variants | where: opt_key, value | first -%}
              <label class="size{% if use_swatches %} size--swatch{% endif %}">
                <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                <span>
                  {%- if use_swatches -%}{{ vmatch.featured_media | image_url: width: 200, height: 200, crop: 'center' | image_tag: alt: '', loading: 'lazy', width: 100, height: 100 }}{%- endif -%}
                  <span class="size__label">{{ value }}</span>
                </span>
              </label>
            {%- endfor -%}
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- if icons.size > 0 -%}
        <div class="icon-row" style="margin-bottom:20px">
          {%- for block in icons -%}<div {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 30 %}{{ block.settings.text }}</div>{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_quantity -%}
        <div class="qty-row">
          <label class="pdp__group-head" for="Qty-{{ section.id }}" style="margin:0">{{ 'products.quantity' | t }}</label>
          <div class="qty-step">
            <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">−</button>
            <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1">
            <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">+</button>
          </div>
        </div>
      {%- endif -%}
      <div class="buy-row">
        <button type="submit" class="btn btn--ink" data-add="{{ 'products.add_to_bag' | t }}" data-soldout="{{ 'products.sold_out' | t }}"{% unless v.available %} disabled{% endunless %}>
          {%- if v.available -%}{{ 'products.add_to_bag' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
        <button type="button" class="icon-btn" data-heart="{{ product.handle }}" aria-pressed="false" aria-label="{{ 'general.save' | t: title: product.title | escape }}">{% render 'icon', name: 'heart' %}</button>
      </div>
      <p class="buy-msg" data-buy-msg role="status" aria-live="polite"></p>
    {%- endform -%}

    {%- if section.settings.guarantee != blank -%}
      <p class="guarantee">{% render 'icon', name: 'shield', size: 18 %}<span>{{ section.settings.guarantee }}</span></p>
    {%- endif -%}

    {%- if section.settings.show_delivery -%}
      <div class="delivery" data-delivery data-ship="{{ section.settings.ship_days }}" data-min="{{ section.settings.delivery_min }}" data-max="{{ section.settings.delivery_max }}" hidden>
        <p class="delivery__by">{{ 'products.get_it_by' | t }} <b data-d="by"></b></p>
        <ol class="delivery__steps">
          <li><span class="delivery__dot"></span><b>{{ 'products.ordered' | t }}</b><span data-d="ordered"></span></li>
          <li><span class="delivery__dot"></span><b>{{ 'products.shipped' | t }}</b><span data-d="shipped"></span></li>
          <li><span class="delivery__dot"></span><b>{{ 'products.delivered' | t }}</b><span data-d="delivered"></span></li>
        </ol>
      </div>
    {%- endif -%}

    <div class="accordion">
      {%- if product.description != blank and section.settings.show_description -%}
        <details{% if section.settings.open_description %} open{% endif %}>
          <summary>{{ section.settings.description_title }}</summary>
          <div class="rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          {%- assign mf_content = nil -%}
          {%- if block.settings.metafield_key != blank -%}
            {%- assign mf_content = product.metafields.custom[block.settings.metafield_key].value -%}
          {%- endif -%}
          {%- if mf_content != blank or block.settings.content != blank or block.settings.page != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="rte">
                {%- if mf_content != blank -%}{{ mf_content | metafield_tag }}{%- elsif block.settings.page != blank -%}{{ block.settings.page.content }}{%- else -%}{{ block.settings.content }}{%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_trust -%}
      <ul class="trust">
        <li>{% render 'icon', name: 'lock', size: 18 %}<span>{{ 'products.trust_secure' | t }}</span></li>
        <li>{% render 'icon', name: 'card', size: 18 %}<span>{{ 'products.trust_payments' | t }}</span></li>
        <li>{% render 'icon', name: 'shield', size: 18 %}<span>{{ 'products.trust_privacy' | t }}</span></li>
        <li>{% render 'icon', name: 'truck', size: 18 %}<span>{{ 'products.trust_shipping' | t }}</span></li>
      </ul>
      <div class="pay-row">{%- for type in shop.enabled_payment_types limit: 8 -%}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{%- endfor -%}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'bundle' -%}
        {%- assign items = block.settings.products -%}
        {%- if items.size > 0 -%}
          {%- assign total = 0 -%}
          <div class="bundle" {{ block.shopify_attributes }}>
            <div class="label">{{ block.settings.title }}</div>
            <div class="bundle__items">
              {%- for p in items limit: 3 -%}
                {%- assign total = total | plus: p.price -%}
                <a href="{{ p.url }}">
                  {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 240, height: 240, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
                  <span>{{ p.title }}</span><b>{{ p.price | money }}</b>
                </a>
              {%- endfor -%}
            </div>
            {%- assign total_money = total | money -%}
            <div style="font-weight:600">{{ 'products.bundle_total' | t: total: total_money }}</div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- if section.settings.size_chart != blank -%}
  <div class="dialog dialog--center" id="SizeChart-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="SizeChartTitle-{{ section.id }}" hidden>
    <div class="dialog__box" style="max-width:720px">
      <button type="button" class="dialog__close icon-btn" data-dialog-close data-dialog-focus aria-label="{{ 'general.close' | t }}">✕</button>
      <h2 class="h3" id="SizeChartTitle-{{ section.id }}" style="margin-bottom:16px">{{ 'products.size_guide' | t }}</h2>
      {%- assign chart_alt = 'products.size_guide' | t -%}
      <img data-src="{{ section.settings.size_chart | image_url: width: 1400 }}" alt="{{ chart_alt }}" width="{{ section.settings.size_chart.width }}" height="{{ section.settings.size_chart.height }}" style="width:100%;height:auto;border-radius:10px">
      {%- if section.settings.size_note != blank -%}<div class="rte" style="margin-top:14px">{{ section.settings.size_note }}</div>{%- endif -%}
    </div>
  </div>
{%- endif -%}

<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div><div style="font-weight:600;font-size:14px">{{ product.title }}</div><div data-sticky-price>{{ v.price | money }}</div></div>
  <button type="button" class="btn btn--ink" tabindex="-1">{{ 'products.add_to_bag' | t }}</button>
</div>

{% schema %}
{
  "name": "Product page",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "max_images", "label": "Max images in gallery", "min": 2, "max": 40, "step": 1, "default": 40 },
    { "type": "text", "id": "tagline", "label": "Short line under the title", "info": "A product metafield custom.tagline overrides this." },
    { "type": "textarea", "id": "promise", "label": "One-sentence promise", "info": "A product metafield custom.one_liner overrides this." },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "image_picker", "id": "size_chart", "label": "Size chart image (opens in a pop-up)" },
    { "type": "richtext", "id": "size_note", "label": "Size chart note", "default": "<p>Roomy, comfortable fit. Between sizes? Choose the larger one, so there's space to wiggle and grow.</p>" },
    { "type": "page", "id": "size_guide", "label": "Or a size guide page" },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
    { "type": "text", "id": "guarantee", "label": "Guarantee line", "default": "Try it for 30 days. Love it or get your money back." },
    { "type": "header", "content": "Delivery estimate" },
    { "type": "checkbox", "id": "show_delivery", "label": "Show 'Get it by' dates", "default": true },
    { "type": "range", "id": "ship_days", "label": "Business days before it ships", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "range", "id": "delivery_min", "label": "Shipping time: fastest (business days)", "min": 1, "max": 30, "step": 1, "default": 7 },
    { "type": "range", "id": "delivery_max", "label": "Shipping time: slowest (business days)", "min": 1, "max": 30, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust badges and payment icons", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show product description in a fold-out row", "default": true },
    { "type": "text", "id": "description_title", "label": "Description row title", "default": "Why parents love it" },
    { "type": "checkbox", "id": "open_description", "label": "Open description by default", "default": false }
  ],
  "blocks": [
    { "type": "question", "name": "Question bubble", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Is it warm enough?", "info": "Tapping it opens the same question in the FAQ section below." } ] },
    { "type": "icon", "name": "Icon benefit", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "heart", "options": [
        { "value": "heart", "label": "Heart" }, { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" },
        { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "zip", "label": "Zip" },
        { "value": "hood", "label": "Hood" }, { "value": "moon", "label": "Moon" }, { "value": "gift", "label": "Gift" } ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Chin-guard zip" } ] },
    { "type": "accordion", "name": "Fold-out row", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Fabric and care" },
      { "type": "richtext", "id": "content", "label": "Text" },
      { "type": "page", "id": "page", "label": "Or show a page" },
      { "type": "text", "id": "metafield_key", "label": "Or a product metafield key (custom.____)" } ] },
    { "type": "bundle", "name": "Set box", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Complete the bedtime set" },
      { "type": "product_list", "id": "products", "label": "Products (3)", "limit": 3 } ] }
  ]
}
{% endschema %}
