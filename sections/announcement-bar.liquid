{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'general.home' | t }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping worldwide · 30-day money-back guarantee", "info": "Say shipping and returns once, here. Leave empty to hide." },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
