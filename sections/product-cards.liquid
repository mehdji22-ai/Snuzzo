<section class="section page-width" data-carousel>
  {%- if section.settings.heading != blank -%}
    <div class="sec-head sec-head--center"><h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="mute lead">{{ section.settings.text }}</p>{%- endif -%}</div>
  {%- endif -%}
  <div class="cards-row" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }}" data-carousel-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign p = block.settings.product
        assign link = block.settings.link
        if link == blank and p != blank
          assign link = p.url
        endif
        assign title = block.settings.title | default: p.title
        assign img = block.settings.image | default: p.featured_image
      -%}
      <a class="pcard bg-{{ block.settings.bg }}" href="{{ link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <div class="pcard__top">
          <div>
            <h3 class="pcard__title">{{ title }}</h3>
            {%- if block.settings.text != blank -%}<p class="pcard__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
          <span class="btn btn--ink btn--sm">{{ block.settings.button }}</span>
        </div>
        {%- if img != blank -%}
          {%- assign alt = block.settings.alt | default: title -%}
          {{ img | image_url: width: 900 | image_tag: class: 'pcard__img', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 80vw', loading: 'lazy', alt: alt }}
        {%- elsif block.settings.demo != blank -%}
          <img class="pcard__img" src="{{ block.settings.demo | asset_url }}" alt="{{ title | escape }}" width="820" height="820" loading="lazy">
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
  <div class="carousel-progress" aria-hidden="true"><span data-carousel-bar></span></div>
</section>

{% schema %}
{
  "name": "Product cards",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A onesie for every moment" },
    { "type": "text", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "One benefit line" },
        { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link (defaults to the product)" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to the product photo)" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "demo", "label": "Demo image (advanced)" },
        { "type": "select", "id": "bg", "label": "Background", "default": "sky", "options": [
          { "value": "sky", "label": "Soft blue" }, { "value": "butter", "label": "Butter" }, { "value": "blush", "label": "Blush" },
          { "value": "mint", "label": "Mint" }, { "value": "cream", "label": "Cream" } ] }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
