<section class="section page-width">
  <div class="narrow">
    <h1 class="h2" style="margin-bottom:24px">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte" style="margin-bottom:24px">{{ page.content }}</div>{%- endif -%}
    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}<p class="form-msg" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ContactEmail">{{ 'customer.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="ContactBody">{{ 'contact.message' | t }}</label><textarea id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea></div>
      <button class="btn btn--ink" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Contact form" }
{% endschema %}
