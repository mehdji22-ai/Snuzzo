<section class="statement section bg-{{ section.settings.bg }}">
  <div class="page-width statement__text">
    <h2 class="display">{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button != blank -%}<p><a class="btn btn--ink" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button }}</a></p>{%- endif -%}
  </div>
  <div class="statement__photos page-width" aria-hidden="true">
    {%- for i in (1..4) -%}
      {%- assign k = 'image_' | append: i -%}
      {%- if section.settings[k] != blank -%}
        <div class="statement__photo">{{ section.settings[k] | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 26vw, 54vw', loading: 'lazy', alt: '' }}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Big statement + photos",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The coziest part\nof their day" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button (optional)" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "image_4", "label": "Photo 4 (small)" },
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ] }
  ],
  "presets": [{ "name": "Big statement + photos" }]
}
{% endschema %}
