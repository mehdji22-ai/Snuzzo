{%- assign c = section.settings.collection -%}
<section class="section page-width" data-carousel>
  <div class="sec-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="margin-bottom:10px">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    {%- if c != blank and section.settings.button != blank -%}<a class="btn btn--outline" href="{{ c.url }}">{{ section.settings.button }}</a>{%- endif -%}
  </div>
  {%- if c != blank and c.products_count > 0 -%}
    <div class="{% if section.settings.layout == 'carousel' %}rail{% else %}grid-4{% endif %}" data-carousel-track>
      {%- for product in c.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 72vw' %}
      {%- endfor -%}
    </div>
    <div class="carousel-progress" aria-hidden="true"{% if section.settings.layout != 'carousel' %} hidden{% endif %}><span data-carousel-bar></span></div>
  {%- else -%}
    <div class="grid-4">
      {%- for i in (1..4) -%}
        <div class="card"><span class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</span><span class="card__price">$00</span><span class="card__name">Pick a collection for this section</span></div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Baby's favourites" },
    { "type": "checkbox", "id": "show_rating", "label": "Show store rating", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop all" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [ { "value": "carousel", "label": "Swipe row" }, { "value": "grid", "label": "Grid" } ] }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
