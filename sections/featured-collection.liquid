{%- assign c = section.settings.collection -%}
<section class="section page-width">
  <div class="picker__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow" style="margin-bottom:8px">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.show_rating and settings.rating_text != blank -%}
      <span class="picker__rating">{{ settings.rating_text }}</span>
    {%- endif -%}
  </div>
  {%- if c != blank and c.products_count > 0 -%}
    <div class="grid-4">
      {%- for product in c.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
    {%- if section.settings.button != blank -%}
      <p style="margin-top:32px;text-align:center"><a class="btn btn--ink" href="{{ c.url }}">{{ section.settings.button }}</a></p>
    {%- endif -%}
  {%- else -%}
    <div class="grid-4">
      {%- for i in (1..4) -%}
        <div class="card"><span class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</span><span class="card__price">$00</span><span class="card__name">Pick a collection for this section</span></div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Baby's favourites" },
    { "type": "checkbox", "id": "show_rating", "label": "Show store rating", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop all best sellers" }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
