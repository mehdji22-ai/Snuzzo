<footer class="site-footer section">
  <div class="page-width">
    <div class="site-footer__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'social' -%}
              <ul>
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook {{ block.settings.facebook_count }}</a></li>{%- endif -%}
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram {{ block.settings.instagram_count }}</a></li>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube {{ block.settings.youtube_count }}</a></li>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
              </ul>
            {%- when 'text' -%}
              <div class="rte">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if section.settings.show_payment -%}
        <span>{% for type in shop.enabled_payment_types limit: 8 %}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{% endfor %}</span>
      {%- endif -%}
    </div>
  </div>
</footer>
<style>.pay-icon{height:22px;width:auto;margin-left:4px;display:inline-block;vertical-align:middle}</style>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "social",
      "name": "Follow column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "paragraph", "content": "Links come from Theme settings → Social media." },
        { "type": "text", "id": "facebook_count", "label": "Facebook follower label", "default": "450K+" },
        { "type": "text", "id": "instagram_count", "label": "Instagram follower label", "default": "21K+" },
        { "type": "text", "id": "youtube_count", "label": "YouTube follower label", "default": "10K+" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Snuzzo" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Plush animal onesies for little ones.</p>" }
      ]
    }
  ]
}
{% endschema %}
