<footer class="site-footer section">
  <div class="page-width">
    <div class="site-footer__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'social' -%}
              <ul>
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook {{ block.settings.facebook_count }}</a></li>{%- endif -%}
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram {{ block.settings.instagram_count }}</a></li>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube {{ block.settings.youtube_count }}</a></li>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
              </ul>
            {%- when 'text' -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.text != blank -%}<p style="margin:0 0 6px">{{ block.settings.text }}</p>{%- endif -%}
              {%- form 'customer', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p role="status" style="color:var(--paper);font-weight:800">{{ 'newsletter.success' | t }}</p>
                {%- else -%}
                  <div class="newsletter">
                    <label class="visually-hidden" for="Newsletter-{{ block.id }}">{{ 'newsletter.label' | t }}</label>
                    <input id="Newsletter-{{ block.id }}" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
                    <button type="submit">{{ 'newsletter.subscribe' | t }}</button>
                  </div>
                  {%- if form.errors -%}<p role="alert">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>{%- endif -%}
                {%- endif -%}
              {%- endform -%}
            {%- when 'policies' -%}
              <ul>
                {%- for policy in shop.policies -%}
                  <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
                {%- endfor -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="site-footer__bottom">
      <span style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <a class="footer-logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}{{ section.settings.logo | image_url: height: 64 | image_tag: alt: shop.name, height: 32 }}{%- else -%}<img src="{{ 'demo-logo.png' | asset_url }}" alt="{{ shop.name }}" width="480" height="86">{%- endif -%}
        </a>
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {% render 'currency-selector', id: 'footer' %}
      </span>
      {%- if section.settings.show_payment -%}
        <span>{% for type in shop.enabled_payment_types limit: 8 %}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{% endfor %}</span>
      {%- endif -%}
    </div>
  </div>
</footer>
<style>.pay-icon{height:22px;width:auto;margin-left:4px;display:inline-block;vertical-align:middle}</style>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (shown in white)" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "social",
      "name": "Follow column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "paragraph", "content": "Links come from Theme settings → Social media." },
        { "type": "text", "id": "facebook_count", "label": "Facebook follower label", "default": "450K+" },
        { "type": "text", "id": "instagram_count", "label": "Instagram follower label", "default": "21K+" },
        { "type": "text", "id": "youtube_count", "label": "YouTube follower label", "default": "10K+" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email sign-up",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join our email list" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get exclusive deals and early access to new products." }
      ]
    },
    {
      "type": "policies",
      "name": "Help & policies column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "paragraph", "content": "Lists your store policies (Settings → Policies) automatically." },
        { "type": "link_list", "id": "menu", "label": "Extra links (optional)" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Snuzzo" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Plush animal onesies for little ones.</p>" }
      ]
    }
  ]
}
{% endschema %}
