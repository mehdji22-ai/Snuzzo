{%- assign news = section.blocks | where: 'type', 'newsletter' | first -%}
<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__news">
      <h2>{{ news.settings.heading | default: section.settings.news_heading }}</h2>
      {%- if news.settings.text != blank -%}<p class="mute" style="margin:-12px 0 20px">{{ news.settings.text }}</p>{%- endif -%}
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p role="status" style="font-weight:600">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter">
            <label class="visually-hidden" for="FooterNewsletter">{{ 'newsletter.label' | t }}</label>
            <input id="FooterNewsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
            <button type="submit">{{ 'newsletter.subscribe' | t }}</button>
          </div>
          {%- if form.errors -%}<p role="alert">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    <div class="site-footer__cols">
      {%- for block in section.blocks -%}
        {%- if block.type != 'newsletter' -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul>{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
            {%- when 'links' -%}
              <ul>
                {%- for i in (1..6) -%}
                  {%- assign lk = 'label_' | append: i -%}{%- assign uk = 'link_' | append: i -%}
                  {%- if block.settings[lk] != blank -%}<li><a href="{{ block.settings[uk] | default: '#' }}">{{ block.settings[lk] }}</a></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'social' -%}
              <ul>
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a></li>{%- endif -%}
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
              </ul>
            {%- when 'policies' -%}
              <ul>
                {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endfor -%}
                {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <div class="rte mute">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="site-footer__brand">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: height: 240 | image_tag: alt: shop.name }}
      {%- else -%}
        <img src="{{ 'demo-logo.png' | asset_url }}" alt="{{ shop.name }}" width="480" height="86" loading="lazy">
      {%- endif -%}
    </a>
  </div>
  <div class="site-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      {% render 'currency-selector', id: 'footer' %}
      {%- if section.settings.show_payment -%}{%- for type in shop.enabled_payment_types limit: 8 -%}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{%- endfor -%}{%- endif -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Big logo" },
    { "type": "text", "id": "news_heading", "label": "Email heading (if no Email sign-up block)", "default": "Cozy news, new animals and little surprises in your inbox" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" } ] },
    { "type": "links", "name": "Links column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "text", "id": "label_1", "label": "Link 1 label" }, { "type": "url", "id": "link_1", "label": "Link 1" },
      { "type": "text", "id": "label_2", "label": "Link 2 label" }, { "type": "url", "id": "link_2", "label": "Link 2" },
      { "type": "text", "id": "label_3", "label": "Link 3 label" }, { "type": "url", "id": "link_3", "label": "Link 3" },
      { "type": "text", "id": "label_4", "label": "Link 4 label" }, { "type": "url", "id": "link_4", "label": "Link 4" },
      { "type": "text", "id": "label_5", "label": "Link 5 label" }, { "type": "url", "id": "link_5", "label": "Link 5" },
      { "type": "text", "id": "label_6", "label": "Link 6 label" }, { "type": "url", "id": "link_6", "label": "Link 6" } ] },
    { "type": "social", "name": "Follow column", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
      { "type": "paragraph", "content": "Links come from Theme settings → Social media." } ] },
    { "type": "newsletter", "name": "Email sign-up", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Cozy news, new animals and little surprises in your inbox" },
      { "type": "text", "id": "text", "label": "Text" } ] },
    { "type": "policies", "name": "Help & policies column", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
      { "type": "link_list", "id": "menu", "label": "Extra links (optional)" } ] },
    { "type": "text", "name": "Text column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Snuzzo" },
      { "type": "richtext", "id": "text", "label": "Text" } ] }
  ]
}
{% endschema %}
