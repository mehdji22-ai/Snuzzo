<section class="page-width" style="padding-top:48px;padding-bottom:48px">
  {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-bottom:24px">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="trio" style="--cols: {{ section.blocks.size | at_least: 1 }}">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h3 class="h3">{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Feature trio",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Chin-guard zip" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A fabric flap covers the zip pull, so it never scratches a sleepy chin." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Feature trio",
      "blocks": [
        { "type": "feature", "settings": { "title": "Chin-guard zip", "text": "A fabric flap covers the zip pull, so it never scratches a sleepy chin." } },
        { "type": "feature", "settings": { "title": "Padded 3D hood", "text": "Cute from behind, and comfortable when they roll onto their back." } },
        { "type": "feature", "settings": { "title": "Soft at wash 100", "text": "Cloud-soft plush with a smooth fleece lining, gentle on delicate skin." } }
      ]
    }
  ]
}
{% endschema %}
