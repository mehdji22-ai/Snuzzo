<section class="section page-width" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:20px">
  <h1 class="h1">{{ 'general.password_title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p style="font-size:19px;max-width:44ch">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="Password">{{ 'general.password_label' | t }}</label><input id="Password" type="password" name="password" autocomplete="current-password"></div>
    <button class="btn btn--ink" type="submit">{{ 'general.password_enter' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Password page" }
{% endschema %}
