<section class="section page-width">
  <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:20px">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <div data-tabs>
      <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Products' | escape }}">
        {%- for block in section.blocks -%}
          <button type="button" class="tab" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        <div role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
          {%- assign c = block.settings.collection -%}
          {%- if c != blank and c.products_count > 0 -%}
            <div class="rail">
              {%- for product in c.products limit: section.settings.limit -%}
                {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 75vw' %}
              {%- endfor -%}
            </div>
            <p style="margin-top:16px"><a class="link-strong" href="{{ c.url }}">{{ 'general.shop_all' | t }}<span class="visually-hidden">: {{ c.title }}</span></a></p>
          {%- else -%}
            <div class="rail">
              {%- for i in (1..4) -%}
                <div class="card"><span class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</span><span class="card__price">$00</span><span class="card__name">Pick a collection for this tab</span></div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Tabbed product rail",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bedtime favourites" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 16, "step": 1, "default": 8 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Best sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Tabbed product rail",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best sellers" } },
        { "type": "tab", "settings": { "label": "Winter" } },
        { "type": "tab", "settings": { "label": "Bath & sleep" } },
        { "type": "tab", "settings": { "label": "For two" } }
      ]
    }
  ]
}
{% endschema %}
