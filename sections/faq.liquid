<section class="section bg-{{ section.settings.bg }}" id="faq"><div class="page-width">
  <div class="faq">
    <div>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="mute" style="margin:14px 0 0;max-width:36ch">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.note != blank -%}
    <p style="margin-top:28px;font-weight:600">{{ section.settings.note }}</p>
  {%- endif -%}
</div></section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "text", "id": "text", "label": "Text", "default": "Everything you need to know." },
    { "type": "text", "id": "note", "label": "Line under the questions", "default": "Still unsure? Every order is covered by our 30-day money-back guarantee." },
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ] }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What size should I order?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Our onesies have a roomy fit. Between sizes? Go one up.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
