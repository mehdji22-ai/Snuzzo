{%- comment -%}
  Renders an uploaded image, or falls back to a demo photo from /assets so the
  theme looks finished before real photos are picked in the theme editor.
  Params: image, demo (asset filename), alt, sizes, class, eager (bool), style
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign sizes_attr = sizes | default: '100vw'
-%}
{%- if image != blank -%}
  {%- assign alt_text = alt | default: image.alt | escape -%}
  {{ image | image_url: width: 2000 | image_tag: widths: '360, 540, 720, 900, 1100, 1440, 2000', sizes: sizes_attr, loading: loading, alt: alt_text, class: class, style: style }}
{%- elsif demo != blank -%}
  <img src="{{ demo | asset_url }}" width="820" height="820" alt="{{ alt | escape }}" loading="{{ loading }}" class="{{ class }}" {% if style %}style="{{ style }}"{% endif %}>
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
