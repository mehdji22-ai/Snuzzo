{%- comment -%}
  Shows the shopping currency in the header (no pop-up, per the brief).
  With several markets, it becomes a small dropdown.
{%- endcomment -%}
{%- if localization.available_countries.size > 1 -%}
  {%- assign form_id = 'Localization-' | append: id -%}
  {%- form 'localization', class: 'currency-form', id: form_id -%}
    <label class="visually-hidden" for="Country-{{ id }}">{{ 'general.currency' | t }}</label>
    <select id="Country-{{ id }}" name="country_code" onchange="this.form.submit()">
      {%- for country in localization.available_countries -%}
        <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
          {{ country.currency.iso_code }} {{ country.currency.symbol }} · {{ country.name }}
        </option>
      {%- endfor -%}
    </select>
    <noscript><button type="submit">OK</button></noscript>
  {%- endform -%}
{%- else -%}
  <span class="currency-label">{{ cart.currency.iso_code }}</span>
{%- endif -%}
