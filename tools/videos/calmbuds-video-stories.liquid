<div class="snzv-story" data-snzv-story hidden role="dialog" aria-modal="true" aria-label="Video">
  <div class="snzv-story__frame">
    <div class="snzv-story__bars" data-snzv-bars></div>
    <button type="button" class="snzv-story__close" data-snzv-close aria-label="Close"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
    <video class="snzv-story__video" data-snzv-video muted playsinline preload="auto"></video>
    <button type="button" class="snzv-story__tap snzv-story__tap--prev" data-snzv-sprev aria-label="Previous video"></button>
    <button type="button" class="snzv-story__tap snzv-story__tap--next" data-snzv-snext aria-label="Next video"></button>
    <div class="snzv-story__foot">
      <p class="snzv-story__label" data-snzv-label></p>
      <p class="snzv-story__text" data-snzv-text></p>
      <button type="button" class="snzv-story__cta" data-snzv-cta>Choose my pack</button>
    </div>
  </div>
</div>

<style>
  .snzv{--ink:#3C2820;--mute:#7A6458;--line:#EAD9CC;--cream:#FDF6EE;margin:26px 0 6px;color:var(--ink);position:relative}
  .snzv__head{text-align:center;margin-bottom:14px}
  .snzv__eyebrow{margin:0 0 4px;font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#B07A5C}
  .snzv__title{margin:0;font-size:22px;line-height:1.15;font-weight:700;letter-spacing:-.01em}
  .snzv__sub{margin:6px auto 0;max-width:330px;font-size:14px;line-height:1.45;color:var(--mute)}
  .snzv__row{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 2px;padding:4px 2px 10px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .snzv__row::-webkit-scrollbar{display:none}
  .snzv__card{position:relative;flex:0 0 42%;max-width:190px;aspect-ratio:9/16;border:0;padding:0;border-radius:18px;overflow:hidden;background:var(--cream);scroll-snap-align:start;cursor:pointer;box-shadow:0 6px 18px rgba(60,40,32,.12);transition:transform .2s ease}
  .snzv__card:active{transform:scale(.98)}
  .snzv__card:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  .snzv__card video,.snzv__card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .snzv__card::after{content:"";position:absolute;inset:auto 0 0 0;height:48%;background:linear-gradient(to top,rgba(30,18,12,.72),rgba(30,18,12,0));pointer-events:none}
  .snzv__play{position:absolute;top:9px;right:9px;z-index:2;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.88);display:grid;place-items:center;color:var(--ink)}
  .snzv__cap{position:absolute;left:11px;right:11px;bottom:10px;z-index:2;text-align:left;color:#fff}
  .snzv__cap b{display:block;font-size:14px;font-weight:700;line-height:1.2}
  .snzv__cap span{display:block;margin-top:2px;font-size:11.5px;line-height:1.3;opacity:.9}
  .snzv__nav{display:none}
  @media (min-width:750px){
    .snzv__card{flex-basis:31%}
    .snzv__nav{display:flex;justify-content:center;gap:10px;margin-top:4px}
    .snzv__arrow{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer}
    .snzv__arrow:hover{background:var(--cream)}
  }
  .snzv-story{position:fixed;inset:0;z-index:2147483100;background:rgba(20,12,8,.94);display:flex;align-items:center;justify-content:center}
  .snzv-story[hidden]{display:none}
  .snzv-story__frame{position:relative;width:100%;height:100%;max-width:min(100vw,calc(100vh * 9 / 16));overflow:hidden;background:#000}
  @media (min-width:750px){.snzv-story__frame{height:min(92vh,860px);max-width:calc(min(92vh,860px) * 9 / 16);border-radius:22px}}
  .snzv-story__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .snzv-story__bars{position:absolute;z-index:3;top:calc(10px + env(safe-area-inset-top));left:10px;right:10px;display:flex;gap:4px}
  .snzv-story__bars span{flex:1;height:3px;border-radius:3px;background:rgba(255,255,255,.35);overflow:hidden}
  .snzv-story__bars i{display:block;height:100%;width:0;background:#fff}
  .snzv-story__close{position:absolute;z-index:4;top:calc(20px + env(safe-area-inset-top));right:8px;width:44px;height:44px;border:0;background:none;color:#fff;cursor:pointer}
  .snzv-story__close{display:grid;place-items:center;border-radius:50%;background:rgba(0,0,0,.25)}
  .snzv-story__close:focus{outline:none}
  .snzv-story__close:focus-visible{outline:2px solid #fff;outline-offset:2px}
  .snzv-story__tap{position:absolute;z-index:2;top:12%;bottom:30%;width:40%;border:0;background:none;cursor:pointer}
  .snzv-story__tap--prev{left:0}.snzv-story__tap--next{right:0}
  .snzv-story__foot{position:absolute;z-index:3;left:0;right:0;bottom:0;padding:70px 18px calc(18px + env(safe-area-inset-bottom));background:linear-gradient(to top,rgba(20,12,8,.85),rgba(20,12,8,0));color:#fff}
  .snzv-story__label{margin:0;font-size:18px;font-weight:700}
  .snzv-story__text{margin:3px 0 14px;font-size:14px;opacity:.9}
  .snzv-story__cta{width:100%;min-height:52px;border:0;border-radius:999px;background:#FDF6EE;color:#3C2820;font:inherit;font-size:16px;font-weight:700;cursor:pointer}
  html.snzv-lock,html.snzv-lock body{overflow:hidden}
  @media (prefers-reduced-motion:reduce){.snzv__card{transition:none}}
</style>

<script>
(function () {
  var root = document.querySelector('[data-snzv]'); if (!root || root.dataset.ready) return; root.dataset.ready = '1';
  var row = root.querySelector('[data-snzv-row]');
  var cards = [].slice.call(root.querySelectorAll('.snzv__card'));
  var story = document.querySelector('[data-snzv-story]'); document.body.appendChild(story);
  var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Small cards: load + play only while on screen (saves data, never slows the page). */
  function load(v) { if (!v.src && v.dataset.src) { v.src = v.dataset.src; } }
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        var v = e.target.querySelector('video');
        if (e.isIntersecting && e.intersectionRatio > 0.55 && !calm && story.hidden) { load(v); var p = v.play(); if (p && p.catch) p.catch(function () {}); }
        else if (!v.paused) v.pause();
      });
    }, { threshold: [0, 0.55, 1] });
    cards.forEach(function (c) { io.observe(c); });
  }
  var step = function (dir) { row.scrollBy({ left: dir * (cards[0].offsetWidth + 10), behavior: 'smooth' }); };
  root.querySelector('[data-snzv-prev]').onclick = function () { step(-1); };
  root.querySelector('[data-snzv-next]').onclick = function () { step(1); };

  /* Story viewer */
  var video = story.querySelector('[data-snzv-video]'), bars = story.querySelector('[data-snzv-bars]');
  var label = story.querySelector('[data-snzv-label]'), text = story.querySelector('[data-snzv-text]');
  var idx = 0, raf = 0, lastFocus = null;
  bars.innerHTML = cards.map(function () { return '<span><i></i></span>'; }).join('');
  var fills = [].slice.call(bars.querySelectorAll('i'));
  function paint() {
    fills.forEach(function (f, k) { f.style.width = k < idx ? '100%' : (k > idx ? '0' : ((video.duration ? video.currentTime / video.duration * 100 : 0) + '%')); });
    if (!story.hidden) raf = requestAnimationFrame(paint);
  }
  function show(i) {
    idx = (i + cards.length) % cards.length;
    var c = cards[idx];
    video.poster = c.dataset.poster; video.src = c.dataset.full;
    label.textContent = c.dataset.label; text.textContent = c.dataset.text;
    var p = video.play(); if (p && p.catch) p.catch(function () {});
  }
  function open(i) {
    lastFocus = document.activeElement;
    cards.forEach(function (c) { var v = c.querySelector('video'); if (!v.paused) v.pause(); });
    story.hidden = false; document.documentElement.classList.add('snzv-lock');
    show(i); cancelAnimationFrame(raf); raf = requestAnimationFrame(paint);
    story.querySelector('[data-snzv-close]').focus();
  }
  function close() {
    story.hidden = true; document.documentElement.classList.remove('snzv-lock');
    video.pause(); video.removeAttribute('src'); video.load(); cancelAnimationFrame(raf);
    if (lastFocus) lastFocus.focus();
  }
  cards.forEach(function (c, i) { c.addEventListener('click', function () { open(i); }); });
  video.addEventListener('ended', function () { if (idx < cards.length - 1) show(idx + 1); else close(); });
  story.querySelector('[data-snzv-sprev]').onclick = function () { show(idx - 1); };
  story.querySelector('[data-snzv-snext]').onclick = function () { if (idx < cards.length - 1) show(idx + 1); else close(); };
  story.querySelector('[data-snzv-close]').onclick = close;
  story.querySelector('[data-snzv-cta]').onclick = function () {
    close();
    var target = document.querySelector('.snzb') || document.querySelector('[data-snzb]');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  document.addEventListener('keydown', function (e) {
    if (story.hidden) return;
    if (e.key === 'Escape') close(); else if (e.key === 'ArrowRight') show(idx + 1); else if (e.key === 'ArrowLeft') show(idx - 1);
  });
  /* Swipe left/right to change video, swipe down to close */
  var sx = 0, sy = 0;
  story.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  story.addEventListener('touchend', function (e) {
    var dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(idx + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) close();
  }, { passive: true });
})();
</script>
